{
  "name": "dsh-newbe-ide",
  "version": "0.4.1",
  "description": "IDE panel for DeepSeek Harness: launch configurations per workspace, start/stop, logs kept inside the browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiqiangvae/dsh-newbe-plugins.git",
    "directory": "packages/dsh-newbe-ide"
  },
  "homepage": "https://github.com/qiqiangvae/dsh-newbe-plugins/tree/main/packages/dsh-newbe-ide#readme",
  "bugs": {
    "url": "https://github.com/qiqiangvae/dsh-newbe-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "previews/*.webp",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit && node --check lib/index.js && node --check lib/typert.host.js && node --check lib/client.js",
    "test": "node build.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.2-rc.1",
    "react": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.2.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
